rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All profile and training writes/reads are handled by the authenticated
    // Vercel API using Firebase Admin. Browser clients cannot bypass API checks.
    match /staff/{uid} {
      allow read, write: if false;
    }
    match /trainingCompletions/{completionId} {
      allow read, write: if false;
    }
  }
}
